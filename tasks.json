{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: Build Vehicle Sensor Monitoring System",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/std:c++17",
                "/W4",
                "/nologo",
                "/I${workspaceFolder}\\include",
                "/Fe${workspaceFolder}\\vehicle_sensor_monitor.exe",
                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\Sensor.cpp",
                "${workspaceFolder}\\src\\Sensors.cpp",
                "${workspaceFolder}\\src\\Vehicle.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds all project sources with the project headers on the include path."
        }
    ],
    "version": "2.0.0"
}